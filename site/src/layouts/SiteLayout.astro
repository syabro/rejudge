---
import { translator } from "../i18n";
import { locales, type Locale } from "../locales";
import "../styles/site.css";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const info = locales[locale];
const t = translator(locale);

// Link previews carry their own text: a preview sits under an image and next to
// the site name, so it needs less than a search result does.
const ogTitle = t("meta.ogTitle", "Independent opinion for your coding agent");
const ogDescription = t("meta.ogDescription", "Several models and a judge dig deeper than one model does.");

const canonical = new URL(info.path, Astro.site);
const enUrl = new URL("/", Astro.site);
const ruUrl = new URL("/ru/", Astro.site);

// Regenerate with /og/ — see src/pages/og.astro. Bump the query when the image
// changes: social platforms cache a preview per URL and never refetch the same one.
const ogImage = new URL("/og.png?2", Astro.site);
const ogImageAlt = t("meta.imageAlt", "The Rejudge wordmark above a terminal recording of a real review run.");
---

<!doctype html>
<html lang={info.lang}>
  <head>
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      try {
        const stored = localStorage.getItem("rejudge-theme");
        document.documentElement.dataset.theme =
          stored ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      } catch {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("meta.title", "Rejudge — Independent Review for AI Agents")}</title>
    {/* The grey line under the blue link in search results, read by someone who has
        not seen the site yet, so it says what Rejudge is rather than selling it.
        Link previews do not use this — they read og:description below. */}
    <meta name="description" content={t("meta.description", "Independent second opinion for coding agents. Several models and a judge dig deeper than one model does. Runs as a CLI, a Pi tool, or an Agent Skill.")} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rejudge" />
    <meta property="og:locale" content={info.ogLocale} />
    <meta property="og:locale:alternate" content={locales[info.alternate].ogLocale} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23000'/%3E%3Ctext x='50' y='69' text-anchor='middle' font-family='Arial' font-size='58' font-weight='700' fill='%23fff'%3ERe%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <div class="wrap">
      <slot />
    </div>
  </body>
</html>
