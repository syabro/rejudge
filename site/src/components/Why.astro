---
import { translator } from "../i18n";
import type { Locale } from "../locales";

type Props = {
  locale: Locale;
};

const t = translator(Astro.props.locale);

const numerals = ["I", "II", "III", "IV"];

const levels = [
  {
    lead: t("why.1.lead", "Same session, same model."),
    body: t("why.1.body", "The agent rereads its own code. It already decided this code is correct, and reading it again does not change that decision."),
  },
  {
    lead: t("why.2.lead", "New session, same model."),
    body: t("why.2.body", "The context is clean, the model is not. It has the same training and the same habits, so it accepts the mistakes it would have written itself."),
  },
  {
    lead: t("why.3.lead", "A different model, its own session."),
    body: t("why.3.body", "A different model does find real bugs. But you now have two opinions, and when they disagree, you are the one who decides which is right."),
  },
];
---

<section class="lede">
  <h2>{t("why.eyebrow", "Why several models")}</h2>
  <p>{t("why.intro", "There are four ways to check code an agent wrote. Each one catches more than the last.")}</p>

  <dl>
    {levels.map((level, index) => (
      <Fragment>
        <dt>{numerals[index]}. {level.lead}</dt>
        <dd>{level.body}</dd>
      </Fragment>
    ))}

    <dt>{numerals[levels.length]}. <span class="brand">Rejudge</span>: {t("why.4.lead", "three models and a judge.")}</dt>
    <dd>{t("why.4.body", "All three models get the same question at once. Each one works in an isolated context and makes its own tool calls, so none of them sees what the others do. The judge reads all three reports, asks follow-up questions where they disagree, and writes one answer. When all three report the same problem, three independent checks agree on it. When they split, the judge resolves it instead of you.")}</dd>
  </dl>
</section>
