---
import type { SiteContent } from "../content";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
---

<section class="lede">
  <h2>{content.why.eyebrow}</h2>
  <p>{content.why.paragraphs[0]}</p>
  <p>{content.why.paragraphs[1]}</p>
  <p><strong>{content.why.conclusion.strong}</strong></p>
  {content.why.conclusion.rest && <p>{content.why.conclusion.rest}</p>}
</section>
