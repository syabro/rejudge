---
import "asciinema-player/dist/bundle/asciinema-player.css";
import { translator } from "../i18n";
import type { Locale } from "../locales";

type Props = {
  locale: Locale;
};

const t = translator(Astro.props.locale);
---

<figure class="run">
  <div class="run-player" id="run-player"></div>
  <figcaption>{t("run.caption", "A real run: three models check shipping.js against its spec, then the judge writes the answer.")}</figcaption>
</figure>

<script>
  import * as AsciinemaPlayer from "asciinema-player";

  const container = document.getElementById("run-player");
  if (container) {
    AsciinemaPlayer.create("/rejudge-demo.cast", container, {
      autoPlay: true,
      controls: false,
      idleTimeLimit: 10,
      loop: true,
    });
  }
</script>
