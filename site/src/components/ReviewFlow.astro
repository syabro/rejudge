---
import { translator } from "../i18n";
import type { Locale } from "../locales";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = translator(locale);

// Every label appears twice below — once in the wide diagram, once in the narrow one.
const flow = {
  agent: t("flow.agent", "Your agent"),
  asksQuestion: t("flow.asksQuestion", "asks a question"),
  models: [
    t("flow.model.1", "Model X"),
    t("flow.model.2", "Model Y"),
    t("flow.model.3", "Model Z"),
  ],
  writesFindings: t("flow.writesFindings", "writes its findings"),
  judge: t("flow.judge", "Judge"),
  comparesFindings: t("flow.comparesFindings", "compares the findings"),
  answer: t("flow.answer", "Answer"),
  answerDescription: t("flow.answerDescription", "based on all findings"),
  runId: [t("flow.runId.1", "+ Run ID"), t("flow.runId.2", "to resume")],
  followUp: [
    t("flow.followUp.1", "asks follow-up questions"),
    t("flow.followUp.2", "when the reviewers disagree"),
  ],
};

const ariaLabel = t("flow.ariaLabel", "Rejudge sends one question to separate models, then a judge compares their findings and returns one answer.");

const wideMarkerId = `wide-arrow-${locale}`;
const narrowMarkerId = `narrow-arrow-${locale}`;
---

<section>
  <h2>{t("flow.eyebrow", "How it works")}</h2>

  <figure class="flow">
    <svg class="wide" viewBox="0 40 920 320" role="img" aria-label={ariaLabel}>
      <defs>
        <marker id={wideMarkerId} markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto">
          <path d="M0,0 L6,3 L0,6 z" class="head"></path>
        </marker>
      </defs>

      <text class="n" x="0" y="146">{flow.agent}</text>
      <text class="d" x="0" y="166">{flow.asksQuestion}</text>

      <path class="l" d="M100 150 H150 M150 60 V240"></path>
      <line class="l" x1="150" y1="60" x2="218" y2="60" marker-end={`url(#${wideMarkerId})`}></line>
      <line class="l" x1="150" y1="150" x2="218" y2="150" marker-end={`url(#${wideMarkerId})`}></line>
      <line class="l" x1="150" y1="240" x2="218" y2="240" marker-end={`url(#${wideMarkerId})`}></line>

      <text class="n" x="234" y="56">{flow.models[0]}</text>
      <text class="d" x="234" y="76">{flow.writesFindings}</text>
      <text class="n" x="234" y="146">{flow.models[1]}</text>
      <text class="d" x="234" y="166">{flow.writesFindings}</text>
      <text class="n" x="234" y="236">{flow.models[2]}</text>
      <text class="d" x="234" y="256">{flow.writesFindings}</text>

      <g class="judge-stage">
        <path class="l" d="M380 60 H448 M380 150 H448 M380 240 H448 M448 60 V240"></path>
        <line class="l" x1="448" y1="150" x2="500" y2="150" marker-end={`url(#${wideMarkerId})`}></line>

        <text class="n" x="514" y="146">{flow.judge}</text>
        <text class="d" x="514" y="170">{flow.comparesFindings}</text>
      </g>

      <g class="result">
        <line class="l" x1="660" y1="150" x2="704" y2="150" marker-end={`url(#${wideMarkerId})`}></line>
        <rect class="output-card" x="712" y="86" width="128" height="128"></rect>
        <text class="output-answer" x="776" y="139" text-anchor="middle">{flow.answer}</text>
        <text class="output-desc" x="776" y="172" text-anchor="middle">{flow.answerDescription}</text>
        <text class="output-meta" x="776" y="226" text-anchor="middle">{flow.runId[0]}</text>
        <text class="output-meta" x="776" y="240" text-anchor="middle">{flow.runId[1]}</text>
      </g>

      <g class="follow-up" transform="translate(-20 0)">
        <path class="l" d="M560 188 V330 H280 V272" marker-end={`url(#${wideMarkerId})`}></path>
        <text class="d" x="410" y="296" text-anchor="middle">{flow.followUp[0]}</text>
        <text class="d" x="410" y="314" text-anchor="middle">{flow.followUp[1]}</text>
      </g>
    </svg>

    <svg class="narrow" viewBox="0 0 420 560" role="img" aria-label={ariaLabel}>
      <defs>
        <marker id={narrowMarkerId} markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto">
          <path d="M0,0 L6,3 L0,6 z" class="head"></path>
        </marker>
      </defs>

      <text class="n" x="210" y="24" text-anchor="middle">{flow.agent}</text>
      <text class="d" x="210" y="44" text-anchor="middle">{flow.asksQuestion}</text>

      <path class="l" d="M210 58 V82 M70 82 H350"></path>
      <line class="l" x1="70" y1="82" x2="70" y2="112" marker-end={`url(#${narrowMarkerId})`}></line>
      <line class="l" x1="210" y1="82" x2="210" y2="112" marker-end={`url(#${narrowMarkerId})`}></line>
      <line class="l" x1="350" y1="82" x2="350" y2="112" marker-end={`url(#${narrowMarkerId})`}></line>

      <text class="n" x="70" y="136" text-anchor="middle">{flow.models[0]}</text>
      <text class="d" x="70" y="156" text-anchor="middle">{flow.writesFindings}</text>
      <text class="n" x="210" y="136" text-anchor="middle">{flow.models[1]}</text>
      <text class="d" x="210" y="156" text-anchor="middle">{flow.writesFindings}</text>
      <text class="n" x="350" y="136" text-anchor="middle">{flow.models[2]}</text>
      <text class="d" x="350" y="156" text-anchor="middle">{flow.writesFindings}</text>

      <path class="l" d="M70 172 V204 M210 172 V204 M350 172 V204 M70 204 H350"></path>
      <line class="l" x1="210" y1="204" x2="210" y2="236" marker-end={`url(#${narrowMarkerId})`}></line>

      <text class="n" x="210" y="262" text-anchor="middle">{flow.judge}</text>
      <text class="d" x="210" y="282" text-anchor="middle">{flow.comparesFindings}</text>

      <g class="follow-up">
        <path class="l" d="M250 282 V356 H350 V172" marker-end={`url(#${narrowMarkerId})`}></path>
        <text class="d" x="110" y="322" text-anchor="middle">{flow.followUp[0]}</text>
        <text class="d" x="110" y="340" text-anchor="middle">{flow.followUp[1]}</text>
      </g>

      <g class="result">
        <line class="l" x1="210" y1="298" x2="210" y2="390" marker-end={`url(#${narrowMarkerId})`}></line>
        <rect class="output-card" x="146" y="398" width="128" height="128"></rect>
        <text class="output-answer" x="210" y="451" text-anchor="middle">{flow.answer}</text>
        <text class="output-desc" x="210" y="484" text-anchor="middle">{flow.answerDescription}</text>
        <text class="output-meta" x="210" y="530" text-anchor="middle">{flow.runId[0]}</text>
        <text class="output-meta" x="210" y="544" text-anchor="middle">{flow.runId[1]}</text>
      </g>
    </svg>

    <p class="summary" set:html={t("flow.summary", `Reviewers get read-only tools: <code>read</code>, <code>grep</code>, <code>find</code>, <code>ls</code>, <code>git_diff</code>. By default they cannot edit files or run shell commands. The judge gets no access to the workspace at all: it sees the three reports and can ask the reviewers more questions, nothing else. Every run ends with a run ID, and <code>rejudge --resume &lt;run-id&gt;</code> reopens the same sessions with a new question.`)} />
  </figure>
</section>
