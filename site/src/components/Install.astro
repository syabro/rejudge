---
import { Code } from "astro:components";
import type { SiteContent } from "../content";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const { steps } = content.install;
const configExample = `{
  "reviewers": [
    "opencode-go/deepseek-v4-pro@high",
    "opencode-go/mimo-v2.5-pro@high",
    "opencode-go/minimax-m3@high"
  ],
  "judge": "opencode-go/glm-5.1@high"
}`;
const askExample = `rejudge "does this migration need a lock?"
git diff | rejudge "review this change"
rejudge --resume <run-id> "what about the rollback path?"`;
---

<section id="install">
  <h2>{content.install.eyebrow}</h2>

  <div class="step">
    <h3><b>01</b> {steps.install.title}</h3>
    <div class="command-copy">
      <pre><code>npm install -g rejudge</code></pre>
      <button type="button" class="copy-command" aria-label={content.install.copy.buttonLabel} data-copy-command="npm install -g rejudge" data-copied-label={content.install.copy.copiedLabel}>{content.install.copy.buttonLabel}</button>
    </div>
    <p>{steps.install.skillsIntro} <a href="https://www.skills.sh/docs/cli" target="_blank" rel="noreferrer">Skills CLI</a>. {steps.install.skillsNote}</p>
    <div class="command-copy">
      <pre><code>npx skills add syabro/rejudge -g</code></pre>
      <button type="button" class="copy-command" aria-label={content.install.copy.buttonLabel} data-copy-command="npx skills add syabro/rejudge -g" data-copied-label={content.install.copy.copiedLabel}>{content.install.copy.buttonLabel}</button>
    </div>
    <p>{steps.install.piIntro} <code>pi install "$(npm root -g)/rejudge"</code></p>
  </div>

  <div class="step">
    <h3><b>02</b> {steps.connect.title}</h3>
    <blockquote class="personal-note">
      <p>“{steps.connect.personalNote[0]} <a href="https://opencode.ai/go" target="_blank" rel="noreferrer">{steps.connect.personalNote[1]}</a> {steps.connect.personalNote[2]}” <cite>@syabro</cite></p>
    </blockquote>

    <p class="env-line">
      {steps.connect.envIntro}
      {steps.connect.envKeys.map((key) => <code>{key}</code>)}
      {steps.connect.envMore} <a href="https://pi.dev/docs/latest/providers#api-keys" target="_blank" rel="noreferrer">{steps.connect.envDocs}</a>
    </p>

    <details class="subscription-auth">
      <summary>{steps.connect.subscriptionSummary}</summary>
      <div>
        <p>{steps.connect.subscriptionIntro[0]} <a href="https://pi.dev/docs/latest/providers#subscriptions" target="_blank" rel="noreferrer">{steps.connect.subscriptionIntro[1]}</a>{steps.connect.subscriptionIntro[2]}</p>
        <div class="command-copy">
          <pre><code>npx -y @earendil-works/pi-coding-agent</code></pre>
          <button type="button" class="copy-command" aria-label={content.install.copy.buttonLabel} data-copy-command="npx -y @earendil-works/pi-coding-agent" data-copied-label={content.install.copy.copiedLabel}>{content.install.copy.buttonLabel}</button>
        </div>
        <p>{steps.connect.login[0]} <code>/login</code> {steps.connect.login[1]}</p>
      </div>
    </details>
  </div>

  <div class="step">
    <h3><b>03</b> {steps.configure.title}</h3>
    <p>{steps.configure.beforeLevels} <code>~/.config/rejudge/config.json</code>{steps.configure.afterPath}</p>
    <Code code={configExample} lang="json" theme="github-light" />
    <p>{steps.configure.levels} <code>minimal</code>, <code>low</code>, <code>medium</code>, <code>high</code>, <code>xhigh</code>.</p>
  </div>

  <div class="step">
    <h3><b>04</b> {steps.ask.title}</h3>
    <Code code={askExample} lang="bash" theme="github-light" />
    <p>{steps.ask.stdout} {steps.ask.piIntro} <code>rejudge</code> {steps.ask.toolConnector} <code>/rejudge</code> {steps.ask.workflowConnector} <code>/rejudge-diff</code> {steps.ask.ending}</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-command").forEach((button) => {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copyCommand ?? "");
      button.textContent = button.dataset.copiedLabel;
      window.setTimeout(() => {
        button.textContent = button.getAttribute("aria-label");
      }, 1500);
    });
  });
</script>
