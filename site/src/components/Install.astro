---
import { Code } from "astro:components";
import { translator } from "../i18n";
import type { Locale } from "../locales";

type Props = {
  locale: Locale;
};

const t = translator(Astro.props.locale);

const copyLabel = t("install.copy", "Copy");
const copiedLabel = t("install.copied", "✓ Copied");

const envKeys = [
  "ANTHROPIC_API_KEY",
  "OPENAI_API_KEY",
  "GEMINI_API_KEY",
  "OPENROUTER_API_KEY",
  "OPENCODE_API_KEY",
];

const reasoningLevels = ["minimal", "low", "medium", "high", "xhigh"];

const piCommand = `pi install "$(npm root -g)/rejudge"`;

const configExample = `{
  "reviewers": [
    "opencode-go/deepseek-v4-pro@high",
    "opencode-go/mimo-v2.5-pro@high",
    "opencode-go/minimax-m3@high"
  ],
  "judge": "opencode-go/glm-5.1@high"
}`;
const askExample = `rejudge "does this migration need a lock?"
git diff | rejudge "review this change"
rejudge --resume <run-id> "what about the rollback path?"`;

// The agent decides to call Rejudge on its own — the tool and skill descriptions
// tell it when. This is what a person says to the agent, so it gets translated.
const agentExample = t("ask.agentExample", `ask rejudge to analyze src/payments and list the potential security holes
/rejudge compare docs/adr/012-event-bus.md against the implementation and list where they diverge
/rejudge-diff`);
---

<section id="install">
  <h2>{t("install.eyebrow", "Quick start")}</h2>

  <div class="step">
    <h3><b>01</b> {t("install.step1.title", "Install Rejudge")}</h3>
    <div class="command-copy">
      <pre><code>npm install -g rejudge</code></pre>
      <button type="button" class="copy-command" aria-label={copyLabel} data-copy-command="npm install -g rejudge" data-copied-label={copiedLabel}>{copyLabel}</button>
    </div>
    <p set:html={t("install.skills", `Using a coding agent other than Pi? Install the Agent Skills so it can call Rejudge, through the <a href="https://www.skills.sh/docs/cli" target="_blank" rel="noreferrer">Skills CLI</a>. Pi is not required on this path.`)} />
    <div class="command-copy">
      <pre><code>npx skills add syabro/rejudge -g</code></pre>
      <button type="button" class="copy-command" aria-label={copyLabel} data-copy-command="npx skills add syabro/rejudge -g" data-copied-label={copiedLabel}>{copyLabel}</button>
    </div>
  </div>

  <div class="step">
    <h3><b>02</b> {t("install.step2.title", "Using Pi? Add the extension")}</h3>
    <div class="command-copy">
      <pre><code>pi install "$(npm root -g)/rejudge"</code></pre>
      <button type="button" class="copy-command" aria-label={copyLabel} data-copy-command={piCommand} data-copied-label={copiedLabel}>{copyLabel}</button>
    </div>
    <p>{t("install.piNote", "Inside Pi you watch the run live and see which model is at which stage. Agents get more control over the tool than over the CLI.")}</p>
  </div>

  <div class="step">
    <h3><b>03</b> {t("install.step3.title", "Connect a provider")}</h3>

    <p>{t("connect.piAlready", "Already using Pi? Nothing to do here. Rejudge takes the providers you set up in Pi.")}</p>

    <p class="env-line">
      {t("connect.env", "Rejudge runs on Pi and reads Pi's provider settings, so any key Pi accepts works here:")}{" "}
      {envKeys.map((key) => <code>{key}</code>)}{" "}
      <Fragment set:html={t("connect.envMore", `and more — the full list is in the <a href="https://pi.dev/docs/latest/providers#api-keys" target="_blank" rel="noreferrer">Pi docs</a>.`)} />
    </p>

    <p set:html={t("connect.personalNote", `I personally use <a href="https://opencode.ai/go?ref=GSCMBMGRST" target="_blank" rel="noreferrer sponsored">OpenCode Go</a> (referral link: $5 for you, $5 for me) because it offers an excellent mix of models for $10 a month.`)} />

    <details class="subscription-auth">
      <summary>{t("connect.subscriptionSummary", "Using a subscription instead of API keys?")}</summary>
      <div>
        <p set:html={t("connect.subscriptionIntro", `For <a href="https://pi.dev/docs/latest/providers#subscriptions" target="_blank" rel="noreferrer">subscription</a> logins Rejudge still goes through Pi. If Pi is not authorized yet, run:`)} />
        <div class="command-copy">
          <pre><code>npx -y @earendil-works/pi-coding-agent</code></pre>
          <button type="button" class="copy-command" aria-label={copyLabel} data-copy-command="npx -y @earendil-works/pi-coding-agent" data-copied-label={copiedLabel}>{copyLabel}</button>
        </div>
        <p set:html={t("connect.login", `Inside Pi, run <code>/login</code> and finish sign-in with your subscription provider.`)} />
      </div>
    </details>
  </div>

  <div class="step">
    <h3><b>04</b> {t("install.step4.title", "Pick your models")}</h3>
    <p set:html={t("configure.path", `Create <code>~/.config/rejudge/config.json</code> once.`)} />
    <Code code={configExample} lang="json" theme="github-light" />
    <p>
      {t("configure.levels", "Two reviewers minimum. Every model needs a reasoning level, and a higher level means a longer and more thorough review:")}{" "}
      {reasoningLevels.map((level, index) => <Fragment>{index > 0 && ", "}<code>{level}</code></Fragment>)}.
    </p>
  </div>

  <div class="step">
    <h3><b>05</b> {t("install.step5.title", "Ask")}</h3>

    <div class="tabs">
      <div class="tab-buttons" role="tablist">
        <button type="button" class="tab-button is-active" data-tab="agent">{t("ask.tab.agent", "Ask your agent")}</button>
        <button type="button" class="tab-button" data-tab="cli">{t("ask.tab.cli", "CLI")}</button>
      </div>

      <div class="tab-panel is-active" data-tab="agent">
        <Code code={agentExample} lang="bash" theme="github-light" />
      </div>
      <div class="tab-panel" data-tab="cli">
        <Code code={askExample} lang="bash" theme="github-light" />
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".tabs").forEach((tabs) => {
    tabs.querySelectorAll<HTMLButtonElement>(".tab-button").forEach((button) => {
      button.addEventListener("click", () => {
        const name = button.dataset.tab;

        tabs.querySelectorAll<HTMLElement>(".tab-button, .tab-panel").forEach((node) => {
          node.classList.toggle("is-active", node.dataset.tab === name);
        });
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".copy-command").forEach((button) => {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copyCommand ?? "");
      button.textContent = button.dataset.copiedLabel;
      window.setTimeout(() => {
        button.textContent = button.getAttribute("aria-label");
      }, 1500);
    });
  });
</script>
