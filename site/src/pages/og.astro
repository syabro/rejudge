---
import "asciinema-player/dist/bundle/asciinema-player.css";
import { translator } from "../i18n";
import "../styles/site.css";

// Workbench for the captures this project ships. Screenshot the #og node for
// public/og.png; it is exactly the 1200x630 that Open Graph expects, so the
// capture needs no crop. The defaults below are the ones the shipped image was
// taken with; override them to try alternatives: /og/?theme=light&pad=48
//
// /og/?bare=1&theme=light strips everything but the recording — record the
// viewport there to get the terminal clip used in the README.
const t = translator("en");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Rejudge — social preview</title>
    <meta name="robots" content="noindex" />
    <script is:inline>
      const params = new URLSearchParams(location.search);
      document.documentElement.dataset.theme = params.get("theme") ?? "dark";

      // ?bare=1 leaves only the recording, so a screen capture of the viewport
      // is the bare terminal clip with no wordmark, no tagline, and no padding.
      if (params.has("bare")) {
        document.documentElement.classList.add("bare");
      }
    </script>
  </head>
  <body>
    <div id="og">
      <h1>Rejudge</h1>
      <p set:html={t("hero.tagline", "Two heads are better than one.<br />Several models and a judge dig deeper.<br />Independent second opinion for your agent.")} />
      <div class="run-player" id="run-player"></div>
    </div>

    <script>
      import * as AsciinemaPlayer from "asciinema-player";

      const pad = new URLSearchParams(location.search).get("pad");
      if (pad) {
        document.getElementById("og")!.style.padding = `${pad}px`;
      }

      const container = document.getElementById("run-player");
      if (container) {
        AsciinemaPlayer.create("/rejudge-demo.cast", container, {
          autoPlay: true,
          controls: false,
          idleTimeLimit: 10,
          loop: true,
        });
      }
    </script>

    <style>
      body{margin:0}

      #og{
        box-sizing:border-box;
        width:1200px;
        height:630px;
        padding:30px;
        display:flex;
        flex-direction:column;
        justify-content:center;
        gap:26px;
        background:var(--page);
        overflow:hidden;
      }

      #og h1{
        margin:0;
        font-size:72px;
        line-height:1;
        font-weight:700;
        letter-spacing:-.025em;
        text-decoration-line:underline;
        text-decoration-thickness:4px;
        text-underline-offset:14px;
        text-decoration-skip-ink:none;
      }

      #og p{
        max-width:940px;
        margin:0;
        font-size:22px;
        line-height:1.45;
      }

      #og .run-player{margin:0;border-radius:8px;overflow:hidden}

      :root.bare #og{width:auto;height:auto;padding:0}
      :root.bare #og h1,:root.bare #og p{display:none}
      :root.bare #og .run-player{border-radius:0}
    </style>
  </body>
</html>
